{
    "name": "ttpryg/queue",
    "description": "Framework-agnostic core queue engine for PHP",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "queue",
        "job",
        "worker",
        "symfony-messenger",
        "pdo"
    ],
    "authors": [
        {
            "name": "Toto",
            "email": "totoprayogo1916@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "psr/log": "^1.0|^2.0|^3.0",
        "psr/event-dispatcher": "^1.0",
        "symfony/messenger": "^6.0|^7.0",
        "symfony/console": "^6.0|^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "suggest": {
        "symfony/amqp-messenger": "For AMQP transport (RabbitMQ)",
        "symfony/redis-messenger": "For Redis transport"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Ttpryg\\Queue\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ttpryg\\Queue\\Tests\\": "tests/"
        }
    }
}
